# Backend API base URL (server-side fetches from Next.js)
# In production with nginx, the rewrite in next.config.mjs handles /api -> 127.0.0.1:3001,
# but server-side data fetching still uses this.
API_URL="http://127.0.0.1:3001"

# 站点对外地址，用于 /status 与 /changelog 的 canonical / OpenGraph
SITE_URL="https://shichiya.cn"

# --- /status 页面使用的服务端探测地址（只在服务器进程内使用，不会下发给浏览器） ---
# 博客接口（NestJS）
STATUS_BLOG_API_URL="http://127.0.0.1:3001"
# ARSENAL 目录接口（回环）
STATUS_ARSENAL_API_URL="http://127.0.0.1:17896"
# 游戏数据服务（回环）
STATUS_DATA_API_URL="http://127.0.0.1:17895"
# 咪娅后台（Koishi HTTP，回环）
STATUS_BOT_ADMIN_URL="http://127.0.0.1:5140"
# 单次探测超时（毫秒）
STATUS_PROBE_TIMEOUT_MS="1500"
# /status 可用率历史目录（生产建议 /var/lib/shichiya-status，需可写）
STATUS_STATE_DIR=".state"
# 可选：允许带 Bearer 令牌从别处写入采样；留空则只允许本机直连
STATUS_RECORD_TOKEN=""